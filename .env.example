# Public, build-time URLs. Do not put secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_SUBMISSION_FORM_URL=
NEXT_PUBLIC_REACTION_FORM_URL=
NEXT_PUBLIC_REPORT_FORM_URL=

# Event-only chat.exe pilot. Keep mode closed except during a moderated event.
# Room names are public browser configuration, not passwords or access control.
NEXT_PUBLIC_LOUNGE_MODE=closed
NEXT_PUBLIC_LOUNGE_ROOM=
NEXT_PUBLIC_LOUNGE_START_AT=
NEXT_PUBLIC_LOUNGE_END_AT=

# Add only after Application Insights settings and privacy behavior receive human review.
NEXT_PUBLIC_APPLICATIONINSIGHTS_CONNECTION_STRING=
