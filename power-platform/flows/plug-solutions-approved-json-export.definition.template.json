{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    },
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "When_a_review_item_is_created_or_modified": {
      "recurrence": {
        "frequency": "Minute",
        "interval": 1
      },
      "splitOn": "@triggerOutputs()?['body/value']",
      "type": "OpenApiConnection",
      "inputs": {
        "parameters": {
          "dataset": "__SHAREPOINT_SITE_URL__",
          "table": "__SHAREPOINT_REVIEW_LIST_ID__"
        },
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetOnUpdatedItems"
        },
        "authentication": "@parameters('$authentication')"
      }
    }
  },
  "actions": {
    "Normalize_raw_submission_values": {
      "runAfter": {},
      "type": "Compose",
      "inputs": {
        "xHandle": "@if(startsWith(trim(string(triggerBody()?['XHandle'])), '@'), trim(string(triggerBody()?['XHandle'])), concat('@', trim(string(triggerBody()?['XHandle']))))",
        "typesAndUses": "@triggerBody()?['TypesAndUses']",
        "relatedUrls": "@triggerBody()?['RelatedUrls']",
        "thumbnailCandidateUrl": "@triggerBody()?['ThumbnailCandidateUrl']",
        "note": "Node後段でQ6/Q8/画像候補を正規化し、未知・不正・重複は要確認として公開不可。XはこのComposeで@を1個補完。Thumbnailはレビュー済みprocessed値のみ出力。"
      }
    },
    "Extract_labeled_related_urls": {
      "runAfter": { "Normalize_raw_submission_values": ["Succeeded"] },
      "type": "Compose",
      "inputs": {
        "sourceUrl": "@if(contains(string(triggerBody()?['RelatedUrls']), 'ソース:'), trim(first(split(trim(last(split(string(triggerBody()?['RelatedUrls']), 'ソース:'))), decodeUriComponent('%0A')))), json('null'))",
        "instructionsUrl": "@if(contains(string(triggerBody()?['RelatedUrls']), '手順:'), trim(first(split(trim(last(split(string(triggerBody()?['RelatedUrls']), '手順:'))), decodeUriComponent('%0A')))), json('null'))",
        "note": "抽出値はNodeのnormalizeRelatedUrlsでHTTPS、ラベル重複、未知ラベル、3件超を検証し、要確認なら公開しない。"
      }
    },
    "Export_only_approved_complete_items": {
      "runAfter": { "Extract_labeled_related_urls": ["Succeeded"] },
      "type": "If",
      "expression": {
        "and": [
          { "equals": ["@triggerBody()?['ReviewStatus/Value']", "承認"] },
          { "equals": ["@empty(triggerBody()?['Slug'])", false] },
          { "equals": ["@empty(triggerBody()?['Title'])", false] },
          { "equals": ["@empty(triggerBody()?['MakerDisplayName'])", false] },
          { "equals": ["@startsWith(outputs('Normalize_raw_submission_values')?['xHandle'], '@')", true] },
          { "equals": ["@empty(triggerBody()?['Description'])", false] },
          { "equals": ["@empty(triggerBody()?['TypesAndUses'])", false] },
          { "equals": ["@startsWith(toLower(triggerBody()?['DistributionUrl']), 'https://')", true] }
        ]
      },
      "actions": {
        "Compose_public_catalog_item": {
          "runAfter": {},
          "type": "Compose",
          "inputs": {
            "schemaVersion": 1,
            "slug": "@triggerBody()?['Slug']",
            "title": "@triggerBody()?['Title']",
            "maker": {
              "displayName": "@triggerBody()?['MakerDisplayName']",
              "xHandle": "@outputs('Normalize_raw_submission_values')?['xHandle']",
              "xUrl": "@concat('https://x.com/', substring(outputs('Normalize_raw_submission_values')?['xHandle'], 1))"
            },
            "description": "@triggerBody()?['Description']",
            "type": "@first(split(replace(triggerBody()?['TypesAndUses'], decodeUriComponent('%0D'), ''), decodeUriComponent('%0A')))",
            "categories": "@json('[\"その他\"]')",
            "tags": "@json('[]')",
            "distributionUrl": "@triggerBody()?['DistributionUrl']",
            "sourceUrl": "@outputs('Extract_labeled_related_urls')?['sourceUrl']",
            "instructionsUrl": "@outputs('Extract_labeled_related_urls')?['instructionsUrl']",
            "license": "配布先を確認",
            "cost": "配布先を確認",
            "premiumRequired": "@json('null')",
            "setupTime": "未記載",
            "prerequisites": "@json('[]')",
            "thumbnail": "@if(empty(triggerBody()?['ThumbnailPath']), json('null'), triggerBody()?['ThumbnailPath'])",
            "publishedAt": "@formatDateTime(coalesce(triggerBody()?['ReviewedAt'], utcNow()), 'yyyy-MM-dd')",
            "updatedAt": "@formatDateTime(coalesce(triggerBody()?['ReviewedAt'], utcNow()), 'yyyy-MM-dd')"
          }
        },
        "Create_or_replace_private_JSON": {
          "runAfter": {
            "Compose_public_catalog_item": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "__SHAREPOINT_SITE_URL__",
              "parameters/method": "POST",
              "parameters/uri": "_api/web/GetFolderByServerRelativeUrl('/sites/PLUGSolutions/Exports')/Files/add(url='@{encodeUriComponent(triggerBody()?['Slug'])}.json',overwrite=true)",
              "parameters/headers": {
                "Accept": "application/json;odata=nometadata",
                "Content-Type": "application/json"
              },
              "parameters/body": "@string(outputs('Compose_public_catalog_item'))"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            }
          }
        }
      },
      "else": {
        "actions": {}
      }
    }
  },
  "outputs": {}
}
