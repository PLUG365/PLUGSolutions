{
  "name": "plug-solutions",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "npm run generate:reaction-manifest",
    "postbuild": "node scripts/clean-static-export.mjs",
    "start": "next dev",
    "thumbnail": "node scripts/process-thumbnail.mjs",
    "generate:reaction-manifest": "node scripts/generate-reaction-manifest.mjs",
    "prepare:approved": "node scripts/prepare-approved-submission.mjs",
    "verify:approved": "node scripts/verify-approved-submission.mjs",
    "import:solution": "node scripts/import-approved-solution.mjs",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "test:worker": "npm --prefix worker test",
    "typecheck:worker": "npm --prefix worker run typecheck",
    "test": "node --test tests/approved-submission.test.mjs tests/canvas-review-lifecycle.test.mjs tests/catalog.test.mjs tests/import-approved-solution.test.mjs tests/lounge-config.test.mjs tests/public-image-url.test.mjs tests/thumbnail.test.mjs tests/workflows.test.mjs",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "check": "npm run lint && npm run validate:catalog && npm test && npm run build && npm run test:rendered",
    "lint": "eslint ."
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
